<section
  id="CustomCta-{{ section.id }}"
  class="custom-cta"
  style="--custom-cta-background: {{ section.settings.background_color }}; --custom-cta-text: {{ section.settings.text_color }}; --custom-cta-secondary: {{ section.settings.secondary_text_color }}; --custom-cta-button: {{ section.settings.button_color }};"
>
  <div class="custom-cta__inner">
    <img class="custom-cta__logo" src="{{ 'custom-cta-logo.svg' | asset_url }}" width="1316" height="507" alt="" aria-hidden="true">

    <div class="custom-cta__content">
      <div class="custom-cta__copy">
        <h2>{{ section.settings.heading | escape | newline_to_br }}</h2>
        <p>{{ section.settings.description | escape }}</p>
      </div>

      {% if section.settings.button_label != blank %}
        <a class="custom-cta__button" href="{{ section.settings.button_url | default: '#' }}">{{ section.settings.button_label | escape }}</a>
      {% endif %}
    </div>

    <div class="custom-cta__product" aria-hidden="true">
      {% if section.settings.product_image != blank %}
        {{ section.settings.product_image | image_url: width: 1200 | image_tag: class: 'custom-cta__product-image', widths: '300, 600, 900, 1200', sizes: '(max-width: 767px) 138px, (max-width: 1023px) 361px, 476px', loading: 'lazy' }}
      {% else %}
        <img class="custom-cta__product-image" src="{{ 'custom-cta-product.png' | asset_url }}" width="1333" height="2000" alt="">
      {% endif %}
    </div>

    <div class="custom-cta__dog" aria-hidden="true">
      {% if section.settings.dog_image != blank %}
        {{ section.settings.dog_image | image_url: width: 1000 | image_tag: class: 'custom-cta__dog-image', widths: '300, 600, 1000', sizes: '(max-width: 767px) 150px, (max-width: 1023px) 259px, 341px', loading: 'lazy' }}
      {% else %}
        <img class="custom-cta__dog-image" src="{{ 'custom-cta-dog.png' | asset_url }}" width="4096" height="2304" alt="">
      {% endif %}
    </div>

    <img class="custom-cta__spark" src="{{ 'custom-cta-spark.svg' | asset_url }}" width="37" height="35" alt="" aria-hidden="true">
    <img class="custom-cta__arrow" src="{{ 'custom-cta-dotted-arrow.svg' | asset_url }}" width="16" height="58" alt="" aria-hidden="true">
  </div>
</section>

{% stylesheet %}
  .custom-cta { padding: 48px clamp(20px, 5.56vw, 80px); font-family: var(--font-primary--family, Montserrat, sans-serif); }
  .custom-cta__inner { position: relative; display: flex; height: 400px; min-height: 400px; align-items: center; overflow: hidden; padding: 40px 64px; border-radius: 32px; background: var(--custom-cta-background, #f9ced9); color: var(--custom-cta-text, #111); isolation: isolate; }
  .custom-cta__logo { position: absolute; z-index: -1; top: -62px; left: max(15%, 192px); width: min(103%, 1316px); height: 507px; pointer-events: none; }
  .custom-cta__content { position: relative; z-index: 2; display: flex; flex-direction: column; gap: 48px; align-items: flex-start; }
  .custom-cta h2, .custom-cta p { margin: 0; }
  .custom-cta__copy { display: flex; flex-direction: column; gap: 24px; }
  .custom-cta h2 { width: min(732px, 100%); font-size: 52px; font-weight: 700; line-height: 1.2; }
  .custom-cta__copy p { width: min(454px, 100%); color: var(--custom-cta-secondary, #4d4e4d); font-size: 16px; line-height: 1.5; }
  .custom-cta__button { display: inline-flex; align-items: center; justify-content: center; padding: 12px 24px; border: 1px solid #111; border-radius: 999px; box-shadow: 3px 3px 0 #111; background: var(--custom-cta-button, #9fdade); color: var(--custom-cta-text, #111); font-size: 16px; font-weight: 600; line-height: 1.5; text-decoration: none; }
  .custom-cta__button:hover { transform: translate(1px, 1px); box-shadow: 2px 2px 0 #111; }
  .custom-cta__product { position: absolute; z-index: 1; top: -111px; left: clamp(518px, 55.5vw, 710px); width: 476px; height: 714px; transform: rotate(180deg) scaleY(-1); }
  .custom-cta__product-image { display: block; width: 100%; height: 100%; object-fit: cover; }
  .custom-cta__dog { position: absolute; z-index: 1; top: 146px; right: -82px; width: 341px; height: 333px; overflow: hidden; }
  .custom-cta__dog-image { position: absolute; top: -23.74%; left: -9.1%; display: block; width: 215.35%; height: 123.74%; max-width: none; object-fit: cover; }
  .custom-cta__spark, .custom-cta__arrow { display: none; }

  @media (min-width: 768px) and (max-width: 1023px) {
    .custom-cta__inner { height: 340px; min-height: 340px; }
    .custom-cta__logo { top: -6px; left: 159px; width: 705px; height: 272px; }
    .custom-cta__product { top: 5px; left: 518px; width: 361px; height: 542px; }
    .custom-cta__dog { top: 222px; right: 73px; width: 259px; height: 254px; }
  }

  @media (max-width: 767px) {
    .custom-cta { padding: 48px 16px; }
    .custom-cta__inner { height: 332px; min-height: 332px; align-items: flex-start; padding: 24px; border-radius: 32px; }
    .custom-cta__logo { top: 6px; left: -20px; width: 423px; height: 163px; }
    .custom-cta__content { width: 100%; gap: 48px; }
    .custom-cta__copy { gap: 12px; }
    .custom-cta h2 { font-size: 32px; }
    .custom-cta__copy p { width: 100%; }
    .custom-cta__product { top: 101px; left: 218px; width: 138px; height: 207px; }
    .custom-cta__dog { top: 264px; right: 17px; width: 150px; height: 147px; }
    .custom-cta__spark { position: absolute; z-index: 2; top: 75px; left: 391px; display: block; width: 37px; height: 35px; transform: rotate(8deg); }
    .custom-cta__arrow { position: absolute; z-index: 2; top: 70px; left: 352px; display: block; width: 16px; height: 58px; transform: rotate(-80deg) scaleY(-1); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom CTA",
  "tag": "section",
  "class": "custom-cta-section",
  "settings": [
    { "type": "image_picker", "id": "product_image", "label": "Product image" },
    { "type": "image_picker", "id": "dog_image", "label": "Dog image" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Make wellbeing\\na daily habit" },
    { "type": "text", "id": "description", "label": "Description", "default": "Join the waitlist for first access and early pricing" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "See what's inside" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#F9CED9" },
    { "type": "color", "id": "button_color", "label": "Button color", "default": "#9FDADE" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#111111" },
    { "type": "color", "id": "secondary_text_color", "label": "Description color", "default": "#4D4E4D" }
  ],
  "presets": [{ "name": "Custom CTA" }]
}
{% endschema %}
