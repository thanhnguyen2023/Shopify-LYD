<section
  id="CustomIngredientFirst-{{ section.id }}"
  class="custom-ingredient"
  style="--custom-ingredient-text: {{ section.settings.text_color }}; --custom-ingredient-secondary: {{ section.settings.secondary_text_color }};"
>
  <div class="custom-ingredient__inner">
    <div class="custom-ingredient__copy">
      <div class="custom-ingredient__heading">
        <h2>{{ section.settings.heading | escape }}</h2>
        <p>{{ section.settings.intro | escape }}</p>
      </div>

      <div class="custom-ingredient__focus">
        <h3>{{ section.settings.focus_heading | escape }}</h3>
        <div class="custom-ingredient__features">
          {% for block in section.blocks %}
            {% render 'custom-ingredient-feature', block: block %}
          {% endfor %}
        </div>
        <p class="custom-ingredient__closing">{{ section.settings.closing_text | escape }}</p>
      </div>
    </div>

    <div class="custom-ingredient__art">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            class: 'custom-ingredient__image',
            widths: '375, 600, 800, 1200, 1600',
            sizes: '(max-width: 767px) calc(100vw - 32px), (max-width: 1023px) calc(100vw - 120px), 50vw',
            loading: 'lazy'
        }}
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .custom-ingredient {
    width: 100%;
    padding: 80px clamp(20px, 5.56vw, 80px);
    color: var(--custom-ingredient-text, #111111);
    font-family: var(--font-primary--family, Montserrat, sans-serif);
  }
  .custom-ingredient__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    width: min(100%, 1280px);
    gap: 64px;
    align-items: center;
    margin-inline: auto;
  }
  .custom-ingredient h2, .custom-ingredient h3, .custom-ingredient p { margin: 0; }
  .custom-ingredient__copy { display: flex; flex-direction: column; gap: 64px; order: 2; }
  .custom-ingredient__heading, .custom-ingredient__focus { display: flex; flex-direction: column; gap: 24px; }
  .custom-ingredient h2 { font-size: 52px; font-weight: 700; line-height: 1.2; }
  .custom-ingredient__heading > p, .custom-ingredient__closing { color: var(--custom-ingredient-secondary, #4d4e4d); font-size: 14px; font-weight: 500; line-height: 1.5; }
  .custom-ingredient h3 { font-size: 24px; font-weight: 700; line-height: 1.5; }
  .custom-ingredient__features { display: flex; flex-direction: column; gap: 8px; }
  .custom-ingredient__feature {
    display: flex;
    width: 100%;
    padding: 24px;
    align-items: flex-start;
    gap: 8px;
    border: 1px solid #111111;
    border-radius: 16px;
    background: #fff;
    color: var(--custom-ingredient-secondary, #4d4e4d);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.5;
  }
  .custom-ingredient__feature img { width: 24px; height: 24px; flex: 0 0 24px; }
  .custom-ingredient__feature div { min-width: 0; }
  .custom-ingredient__feature p { display: inline; }
  .custom-ingredient__feature strong { color: var(--custom-ingredient-text, #111111); font-weight: 700; }
  .custom-ingredient__art {
    order: 1;
    width: 100%;
  }
  .custom-ingredient__image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 16px;
  }
  @media (max-width: 1023px) {
    .custom-ingredient { padding: 64px clamp(20px, 7.8vw, 60px); }
    .custom-ingredient__inner { display: flex; flex-direction: column; gap: 48px; align-items: stretch; }
    .custom-ingredient__copy { order: 1; gap: 48px; }
    .custom-ingredient__art { order: 2; align-self: center; max-width: 644px; }
    .custom-ingredient h2 { font-size: 48px; }
    .custom-ingredient__heading, .custom-ingredient__focus { gap: 20px; }
  }

  @media (max-width: 767px) {
    .custom-ingredient { padding: 48px 16px; }
    .custom-ingredient__inner, .custom-ingredient__copy { gap: 32px; }
    .custom-ingredient h2 { font-size: 32px; }
    .custom-ingredient__heading, .custom-ingredient__focus { gap: 16px; }
    .custom-ingredient__feature { padding: 16px; }
    .custom-ingredient__art { width: 100%; max-width: 343px; }
    .custom-ingredient__image { border-radius: 7px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom Ingredient First",
  "tag": "section",
  "class": "custom-ingredient-first-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ingredient-first. Always." },
    { "type": "text", "id": "intro", "label": "Intro", "default": "Every ingredient in Loveyou Daily earns its place." },
    { "type": "text", "id": "focus_heading", "label": "Focus heading", "default": "We focus on:" },
    { "type": "text", "id": "closing_text", "label": "Closing text", "default": "If it doesn’t serve taste and purpose, it doesn’t go in." },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#111111" },
    { "type": "color", "id": "secondary_text_color", "label": "Body color", "default": "#4D4E4D" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "limit": 3,
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p><strong>Human-grade, food-quality ingredients</strong></p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Ingredient First",
      "blocks": [
        { "type": "feature", "settings": { "text": "<p><strong>Human-grade, food-quality ingredients</strong></p>" } },
        { "type": "feature", "settings": { "text": "<p><strong>Evidence-backed nutrients</strong> commonly used in veterinary nutrition</p>" } },
        { "type": "feature", "settings": { "text": "<p>Ingredients selected for <strong>both function and palatability</strong></p>" } }
      ]
    }
  ]
}
{% endschema %}
