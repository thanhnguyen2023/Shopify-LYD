<section
  id="CustomOwnersNotice-{{ section.id }}"
  class="custom-owners-notice"
  style="--custom-owners-notice-text: {{ section.settings.text_color }}; --custom-owners-notice-secondary: {{ section.settings.secondary_text_color }}; --custom-owners-notice-card: {{ section.settings.card_color }}; --custom-owners-notice-note: {{ section.settings.note_color }};"
>
  <div class="custom-owners-notice__inner">
    <div class="custom-owners-notice__copy">
      <h2>{{ section.settings.heading | escape | newline_to_br }}</h2>
      <p>{{ section.settings.description | escape }}</p>
    </div>

    <div class="custom-owners-notice__visual">
      <div class="custom-owners-notice__image-wrap">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1400 | image_tag: class: 'custom-owners-notice__image', widths: '375, 600, 900, 1200, 1400', sizes: '(max-width: 767px) calc(100vw - 32px), (max-width: 1023px) min(581px, 100vw - 120px), 581px', loading: 'lazy' }}
        {% else %}
          <img class="custom-owners-notice__image" src="{{ 'custom-owners-notice-image.png' | asset_url }}" width="1428" height="2000" alt="">
        {% endif %}
      </div>

      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'card' %}
            {% render 'custom-owners-notice-card', block: block, position: forloop.index %}
        {% endcase %}
      {% endfor %}
    </div>

    <p class="custom-owners-notice__note">{{ section.settings.note | escape }}</p>
  </div>
</section>

{% stylesheet %}
  .custom-owners-notice { padding: 80px clamp(20px, 5.56vw, 80px); color: var(--custom-owners-notice-text, #111); font-family: var(--font-primary--family, Montserrat, sans-serif); }
  .custom-owners-notice__inner { display: grid; grid-template-columns: minmax(0, 482px) minmax(0, 1fr); grid-template-areas: 'copy visual' 'copy note'; align-items: center; gap: 36px 64px; width: min(100%, 1280px); margin-inline: auto; }
  .custom-owners-notice h2, .custom-owners-notice p { margin: 0; }
  .custom-owners-notice__copy { grid-area: copy; display: flex; flex-direction: column; gap: 24px; align-self: center; }
  .custom-owners-notice h2 { font-size: 52px; font-weight: 700; line-height: 1.2; }
  .custom-owners-notice__copy > p { width: min(454px, 100%); color: var(--custom-owners-notice-secondary, #4d4e4d); font-size: 18px; line-height: 1.5; }
  .custom-owners-notice__visual { position: relative; grid-area: visual; justify-self: end; width: min(100%, 667px); height: 624px; }
  .custom-owners-notice__image-wrap { position: absolute; top: 36px; right: 0; width: min(87.1%, 581px); height: 552px; overflow: hidden; border-radius: 24px; }
  .custom-owners-notice__image { display: block; width: 100%; height: 100%; object-fit: cover; }
  .custom-owners-notice__card { position: absolute; z-index: 1; display: flex; align-items: center; justify-content: center; box-sizing: border-box; padding: 16px 24px; border: 1px solid #111; border-radius: 16px; background: var(--custom-owners-notice-card, #febfad); box-shadow: 4px 4px 0 #111; color: var(--custom-owners-notice-text, #111); font-size: 18px; font-weight: 500; line-height: 1.5; text-align: center; }
  .custom-owners-notice__card--1 { top: 0; left: 37px; width: 201px; }
  .custom-owners-notice__card--2 { top: 385px; left: 0; width: 201px; }
  .custom-owners-notice__card--3 { top: 237px; right: 0; width: 281px; }
  .custom-owners-notice__note { grid-area: note; justify-self: center; padding: 8px 12px; border-radius: 12px; background: var(--custom-owners-notice-note, #ffffbe); color: var(--custom-owners-notice-secondary, #4d4e4d); font-size: 14px; font-weight: 500; line-height: 1.5; text-align: center; }

  @media (min-width: 768px) and (max-width: 1023px) {
    .custom-owners-notice { padding: 64px clamp(20px, 7.8vw, 60px); }
    .custom-owners-notice__inner { display: flex; flex-direction: column; align-items: flex-start; gap: 64px; }
    .custom-owners-notice__copy { width: 482px; max-width: 100%; }
    .custom-owners-notice__visual { align-self: center; }
    .custom-owners-notice__note { align-self: center; }
  }

  @media (max-width: 767px) {
    .custom-owners-notice { padding: 48px 16px; }
    .custom-owners-notice__inner { display: flex; flex-direction: column; align-items: stretch; gap: 64px; }
    .custom-owners-notice__copy { gap: 24px; }
    .custom-owners-notice h2 { font-size: 32px; }
    .custom-owners-notice__copy > p { width: 100%; }
    .custom-owners-notice__visual { align-self: center; width: min(100%, 343px); height: 463px; }
    .custom-owners-notice__image-wrap { top: 0; right: 0; width: 100%; height: 420px; }
    .custom-owners-notice__card { padding: 16px; font-size: 12px; }
    .custom-owners-notice__card--1 { top: -29px; left: auto; right: 0; width: 134px; }
    .custom-owners-notice__card--2 { top: 351px; left: auto; right: 15px; width: 114px; }
    .custom-owners-notice__card--3 { top: 143px; right: auto; left: -7px; width: 137px; }
    .custom-owners-notice__note { align-self: stretch; width: auto; font-size: 12px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom Owners Notice",
  "tag": "section",
  "class": "custom-owners-notice-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "What some owners report over time" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "While every dog is different, some owners report:" },
    { "type": "text", "id": "note", "label": "Disclaimer", "default": "*Individual experiences vary and depend on consistent daily use." },
    { "type": "color", "id": "text_color", "label": "Heading color", "default": "#111111" },
    { "type": "color", "id": "secondary_text_color", "label": "Body color", "default": "#4D4E4D" },
    { "type": "color", "id": "card_color", "label": "Card color", "default": "#FEBFAD" },
    { "type": "color", "id": "note_color", "label": "Disclaimer color", "default": "#FFFFBE" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Owner observation",
      "limit": 3,
      "settings": [
        { "type": "textarea", "id": "text", "label": "Text", "default": "Dogs enjoying the ritual" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Owners Notice",
      "blocks": [
        { "type": "card", "settings": { "text": "Dogs enjoying the ritual" } },
        { "type": "card", "settings": { "text": "Easier daily routines" } },
        { "type": "card", "settings": { "text": "Visible coat condition improvements over time" } }
      ]
    }
  ]
}
{% endschema %}
