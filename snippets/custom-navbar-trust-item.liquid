{% comment %}
  Accepts:
  - text: trust item label
  - attributes: optional Shopify block attributes
{% endcomment %}

<div class="custom-navbar__trust-item" {{ attributes }}>
  <span class="custom-navbar__trust-icon" aria-hidden="true">
    {% render 'custom-navbar-icon', name: 'seal-check' %}
  </span>
  <span>{{ text | escape }}</span>
</div>
